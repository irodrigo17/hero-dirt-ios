    "Riding now can leave ruts. Give it a day or so.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fahren kann jetzt Spurrillen hinterlassen. Warte etwa einen Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Riding now can leave ruts. Give it a day or so."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodar ahora puede dejar surcos. Espera un día más o menos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rouler maintenant risque de creuser des ornières. Attendez environ une journée."
