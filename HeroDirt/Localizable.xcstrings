    "You know your local trails best. These settings fine-tune how fast this spot dries out after rain.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kennst deine Trails am besten. Mit diesen Einstellungen passt du an, wie schnell dieser Ort nach Regen trocknet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You know your local trails best. These settings fine-tune how fast this spot dries out after rain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú conoces tus senderos mejor que nadie. Estos ajustes afinan la velocidad de secado de este lugar después de llover."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous connaissez vos sentiers mieux que personne. Ces réglages affinent la vitesse de séchage de ce lieu après la pluie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地元のトレイルを一番よく知っているのはあなたです。この設定で、雨の後にこの場所が乾く速さを微調整できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você conhece suas trilhas melhor que ninguém. Estes ajustes refinam a velocidade de secagem deste local após a chuva."
          }
        }
      }
    },
