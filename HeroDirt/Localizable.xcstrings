    "Search for a trail or park, tap a spot on the map, or long-press to drop a pin. Then tap Save to keep an eye on it here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche einen Trail oder Park, tippe auf einen Ort auf der Karte oder halte gedrückt, um eine Markierung zu setzen. Tippe dann auf Speichern, um ihn hier zu verfolgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search for a trail or park, tap a spot on the map, or long-press to drop a pin. Then tap Save to keep an eye on it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca un sendero o parque, toca un lugar del mapa o mantén pulsado para soltar un marcador. Después toca Guardar para seguir su estado aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cherchez un sentier ou un parc, touchez un lieu sur la carte ou appuyez longuement pour placer un repère. Touchez ensuite Enregistrer pour suivre son état ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トレイルや公園を検索したり、地図上の場所をタップしたり、長押しでピンを置いたりできます。「保存」をタップすると、ここで状況を確認できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque uma trilha ou parque, toque em um local no mapa ou mantenha pressionado para soltar um alfinete. Depois toque em Salvar para acompanhar as condições aqui."
          }
        }
      }
    },
    "Search for the trails and parks you ride, or find them on the map, and save them to see when they're ridable.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche deine Trails und Parks oder finde sie auf der Karte. Speichere sie, um zu sehen, wann sie fahrbar sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search for the trails and parks you ride, or find them on the map, and save them to see when they're ridable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca los senderos y parques donde montas, o encuéntralos en el mapa, y guárdalos para saber cuándo se puede rodar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cherchez vos sentiers et parcs ou trouvez-les sur la carte, puis enregistrez-les pour savoir quand ils sont praticables."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "走りたいトレイルや公園を検索するか、地図で見つけて保存すると、走れる時期を確認できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque as trilhas e parques onde você pedala ou encontre-os no mapa. Salve para saber quando as condições estão boas para pedalar."
          }
        }
      }
    },
