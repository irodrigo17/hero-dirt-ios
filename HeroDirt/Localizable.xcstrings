    "Apple Maps couldn't retrieve this place. Check your connection and try opening the link again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Karten konnte diesen Ort nicht laden. Prüfe deine Verbindung und öffne den Link erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Maps couldn't retrieve this place. Check your connection and try opening the link again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapas de Apple no ha podido obtener este lugar. Comprueba la conexión y vuelve a abrir el enlace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plans d’Apple n’a pas pu récupérer ce lieu. Vérifiez votre connexion et rouvrez le lien."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleマップでこの場所を取得できませんでした。接続を確認して、リンクをもう一度開いてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mapas da Apple não conseguiu carregar este lugar. Verifique sua conexão e tente abrir o link novamente."
          }
        }
      }
    },
