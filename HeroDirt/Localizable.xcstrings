    "Hero Dirt is a free, open source app that helps mountain bikers find hero dirt: that perfect tacky, grippy trail you get a day or two after the rain.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hero Dirt ist eine kostenlose Open-Source-App, die Mountainbikern hilft, den perfekten Boden zu finden: griffige Trails ein bis zwei Tage nach dem Regen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hero Dirt is a free, open source app that helps mountain bikers find hero dirt: that perfect tacky, grippy trail you get a day or two after the rain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hero Dirt es una app gratuita y de código abierto que ayuda a ciclistas de montaña a encontrar el terreno ideal: ese sendero con agarre perfecto uno o dos días después de llover."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hero Dirt est une app gratuite et open source qui aide les vététistes à trouver le terrain idéal : un sentier offrant une adhérence parfaite un ou deux jours après la pluie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hero Dirtは、マウンテンバイカーが理想の路面を見つけるための無料オープンソースアプリです。雨の1～2日後に現れる、しっとりとしてグリップのよいトレイルを探せます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hero Dirt é um app gratuito e de código aberto que ajuda ciclistas de mountain bike a encontrar o solo ideal: aquela trilha com aderência perfeita um ou dois dias depois da chuva."
          }
        }
      }
    },
