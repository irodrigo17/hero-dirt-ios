    "Saved places are stored in your personal iCloud account (if enabled) and sync automatically across all your iOS devices.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Orte werden in deinem persönlichen iCloud-Konto abgelegt (falls aktiviert) und automatisch mit deinen iOS-Geräten synchronisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved places are stored in your personal iCloud account (if enabled) and sync automatically across all your iOS devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los lugares guardados se almacenan en tu cuenta personal de iCloud (si está activada) y se sincronizan automáticamente en tus dispositivos iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lieux sont enregistrés dans votre compte iCloud personnel (si activé) et se synchronisent automatiquement sur vos appareils iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した場所は個人のiCloudアカウントに保存され（有効な場合）、すべてのiOSデバイスで自動的に同期されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lugares salvos ficam na sua conta pessoal do iCloud (se ativada) e são sincronizados automaticamente entre seus dispositivos iOS."
          }
        }
      }
    },
    "Saved places are syncing across your devices.": {
