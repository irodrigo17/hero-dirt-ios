          "stringUnit": {
            "state": "translated",
            "value": "Puddles and peanut butter mud. Give the trails a few days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Charcos y barro muy pegajoso. Deja descansar los senderos unos días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaques et boue très collante. Laissez les sentiers sécher quelques jours."
          }
        },
