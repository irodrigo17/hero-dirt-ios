    "Amounts in %@. A dash means no observed data. Today's amount includes only rain recorded so far.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengen in %@. Ein Strich bedeutet, dass keine Messdaten vorliegen. Die heutige Menge enthält nur den bisher erfassten Regen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amounts in %@. A dash means no observed data. Today's amount includes only rain recorded so far."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cantidades en %@. Un guion indica que no hay datos observados. La cantidad de hoy solo incluye la lluvia registrada hasta ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantités en %@. Un tiret indique l’absence de données observées. Le total du jour comprend uniquement la pluie déjà enregistrée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単位は%@です。ダッシュは観測データがないことを示します。今日の雨量は、現時点までに記録された分のみです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores em %@. Um traço indica que não há dados observados. O valor de hoje inclui apenas a chuva registrada até agora."
          }
        }
      }
    },
