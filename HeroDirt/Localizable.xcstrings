    "iCloud access is restricted. Saved places are stored locally only.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der iCloud-Zugriff ist eingeschränkt. Orte werden nur lokal gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud access is restricted. Saved places are stored locally only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a iCloud está restringido. Los lugares se guardan solo en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à iCloud est restreint. Les lieux sont enregistrés uniquement sur cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudへのアクセスが制限されています。保存した場所はこのデバイスにのみ保存されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao iCloud está restrito. Os lugares são salvos apenas neste dispositivo."
          }
        }
      }
    },
    "iCloud is temporarily unavailable. Saved places are stored locally and will sync when it recovers.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ist vorübergehend nicht verfügbar. Orte werden lokal gespeichert und später synchronisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is temporarily unavailable. Saved places are stored locally and will sync when it recovers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud no está disponible temporalmente. Los lugares se guardan en este dispositivo y se sincronizarán cuando se restablezca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud est temporairement indisponible. Les lieux sont enregistrés sur l’appareil et seront synchronisés dès son rétablissement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudを一時的に利用できません。場所はこのデバイスに保存され、復旧後に同期されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iCloud está temporariamente indisponível. Os lugares são salvos no dispositivo e serão sincronizados quando o serviço voltar."
          }
        }
      }
    },
